// Template. Copy it to wrangler.jsonc (not committed), fill in your
// Worker name and D1 database, and keep everything else in step with this
// file: the tests run on this template and fail when the two drift apart.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Your Worker's name. Its URL becomes https://<name>.<your-subdomain>.workers.dev
  "name": "community",
  "main": "src/index.ts",
  // Latest date the bundled workerd (1.20261104.1) supports.
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      // From `npx wrangler d1 create <name>` (see the README).
      "database_name": "community",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Write limits. Counted per Cloudflare location and approximate, see
  // https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
  // Neither number is tuned yet.
  "ratelimits": [
    {
      // Per anonymous ID.
      "name": "WRITE_LIMIT_ANON",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Per IP. Looser, because many phones can share one IP behind a
      // mobile carrier.
      "name": "WRITE_LIMIT_IP",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // Hearts per anonymous ID, apart from posts.
      "name": "REACTION_LIMIT_ANON",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      // Hearts per IP. Any UUID passes as an anonymous ID, so this is the
      // limit that holds when someone makes up new IDs.
      "name": "REACTION_LIMIT_IP",
      "namespace_id": "1004",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // New, edited and deleted comments per anonymous ID, apart from posts.
      "name": "COMMENT_LIMIT_ANON",
      "namespace_id": "1005",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Comments per IP.
      "name": "COMMENT_LIMIT_IP",
      "namespace_id": "1006",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
